VOICE_MORPHER_HOST=127.0.0.1
VOICE_MORPHER_PORT=8000
VOICE_MORPHER_DATA_DIR=data
VOICE_MORPHER_MODELS_DIR=models
VOICE_MORPHER_MODEL_CATALOG_PATH=config/models.toml
VOICE_MORPHER_COSYVOICE_REPO_DIR=external/CosyVoice
VOICE_MORPHER_COSYVOICE3_MODEL_DIR=models/Fun-CosyVoice3-0.5B-2512
VOICE_MORPHER_MAX_UPLOAD_MB=100
VOICE_MORPHER_MAX_AUDIO_SECONDS=600
VOICE_MORPHER_SAMPLE_RATE=24000

